# Copy file nay thanh .env va dien gia tri that.
# .env khong duoc commit len git (da khai bao trong .gitignore).

TELEGRAM_BOT_TOKEN=
ANTIGRAVITY_API_BASE=
ANTIGRAVITY_API_KEY=
AI_MODEL_NAME=

# Tuy chon
SYSTEM_PROMPT=Ban la mot tro ly AI huu ich, tra loi ngan gon va chinh xac.
MAX_HISTORY_MESSAGES=20

# Danh sach model cho phep chon qua lenh /model (phan cach bang dau phay).
# Neu bo trong, mac dinh chi co AI_MODEL_NAME.
AVAILABLE_MODELS=gemini-3.1-pro-high,gemini-3.1-flash-image
